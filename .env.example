# Frontend Environment Variables (client/.env)
VITE_API_BASE_URL=http://localhost:5001/api

# Backend Environment Variables (server/.env)
PORT=5001
NODE_ENV=development

# Optional MongoDB Database (Leave empty for in-memory / local storage demo mode)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/explorex?retryWrites=true&w=majority

# Optional AI API Key (Gemini or OpenAI - Application works seamlessly with built-in intelligent generator if omitted)
AI_API_KEY=
AI_PROVIDER=gemini
